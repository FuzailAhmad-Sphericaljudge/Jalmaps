# ---------------------------------------------------------------------------
# JalMaps environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values:
#
#   cp .env.example .env.local
#
# Never commit real secrets. `.env*` files are gitignored by default.
# Restart the dev server after changing any of these values.
# ---------------------------------------------------------------------------

# Supabase project URL — printed by `pnpm db:start` for local development,
# or found in Supabase Dashboard → Project Settings → API for a hosted project.
# Local example: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key — printed by `pnpm db:start` locally or
# labelled "anon public" in the hosted dashboard.
# Safe to expose in the browser: data access is protected by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — same dashboard page, labelled "service_role".
# SECRET. Bypasses row level security. Server-side code only — never prefix
# with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pseudo-localisation for i18n layout testing. Set to "1" to render all
# English copy accented and ~40% expanded ([…!!!] brackets), exposing clipped
# layouts and hard-coded strings. App-wide; alternatively visit any page with
# ?pseudo=1 (sets a session cookie, ?pseudo=0 clears it) without touching env.
NEXT_PUBLIC_PSEUDO_LOCALE=
